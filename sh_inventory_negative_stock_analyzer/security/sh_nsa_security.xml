<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_nsa" model="res.groups.privilege">
        <field name="name">Negative Stock Analyzer</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_nsa_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_nsa"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="nsa_incident_company_rule" model="ir.rule">
        <field name="name">Negative Stock Incident: multi-company</field>
        <field name="model_id" ref="model_inventory_negative_stock_incident"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="nsa_product_company_rule" model="ir.rule">
        <field name="name">Negative Stock Product: multi-company</field>
        <field name="model_id" ref="model_inventory_negative_stock_product"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
