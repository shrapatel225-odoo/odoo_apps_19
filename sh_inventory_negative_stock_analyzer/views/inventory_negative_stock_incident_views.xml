<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inventory_negative_stock_incident_search" model="ir.ui.view">
        <field name="name">inventory.negative.stock.incident.search</field>
        <field name="model">inventory.negative.stock.incident</field>
        <field name="arch" type="xml">
            <search string="Negative Stock Incidents">
                <field name="name"/>
                <field name="product_id"/>
                <field name="product_default_code"/>
                <field name="location_id"/>
                <field name="warehouse_id"/>
                <field name="trigger_picking_id"/>
                <field name="origin_document_name"/>
                <filter name="filter_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="filter_corrected" string="Corrected" domain="[('is_corrected', '=', True)]"/>
                <filter name="filter_current_negative" string="Current Negative" domain="[('state', '=', 'active')]"/>
                <filter name="filter_historical" string="Historical Negative" domain="[('is_corrected', '=', True)]"/>
                <separator/>
                <filter name="filter_insufficient" string="Insufficient Stock" domain="[('root_cause_type', '=', 'insufficient_stock')]"/>
                <filter name="filter_reservation" string="Reservation Issue" domain="[('root_cause_type', '=', 'reservation_issue')]"/>
                <filter name="filter_timing" string="Sequence / Timing" domain="[('root_cause_type', '=', 'sequence_timing')]"/>
                <filter name="filter_transfer" string="Transfer Issue" domain="[('root_cause_type', '=', 'transfer_issue')]"/>
                <filter name="filter_inventory" string="Inventory Adjustment" domain="[('root_cause_type', '=', 'inventory_adjustment')]"/>
                <separator/>
                <filter name="filter_incident_date" string="Incident Date" date="incident_datetime"/>
                <group>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_location" string="Location" context="{'group_by': 'location_id'}"/>
                    <filter name="group_warehouse" string="Warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <filter name="group_cause" string="Root Cause" context="{'group_by': 'root_cause_type'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_categ" string="Product Category" context="{'group_by': 'categ_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_inventory_negative_stock_incident_list" model="ir.ui.view">
        <field name="name">inventory.negative.stock.incident.list</field>
        <field name="model">inventory.negative.stock.incident</field>
        <field name="arch" type="xml">
            <list string="Negative Stock Incidents" create="false">
                <field name="name"/>
                <field name="product_id"/>
                <field name="product_default_code" optional="show"/>
                <field name="warehouse_id" optional="show"/>
                <field name="location_id"/>
                <field name="stock_before"/>
                <field name="movement_qty"/>
                <field name="stock_after"/>
                <field name="trigger_picking_id"/>
                <field name="origin_document_name"/>
                <field name="root_cause_type"/>
                <field name="incident_datetime"/>
                <field name="is_corrected"/>
                <field name="state" widget="badge"
                    decoration-danger="state == 'active'"
                    decoration-success="state == 'corrected'"
                    decoration-warning="state == 'investigating'"
                    decoration-muted="state == 'unknown'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_inventory_negative_stock_incident_form" model="ir.ui.view">
        <field name="name">inventory.negative.stock.incident.form</field>
        <field name="model">inventory.negative.stock.incident</field>
        <field name="arch" type="xml">
            <form string="Negative Stock Incident" create="false" edit="false">
                <header>
                    <button name="action_open_trigger_move" type="object" string="Open Movement" class="btn-primary" invisible="not trigger_move_id"/>
                    <button name="action_open_picking" type="object" string="Open Picking" invisible="not trigger_picking_id"/>
                    <button name="action_open_source_document" type="object" string="Open Source Document" invisible="not origin_document_res_id"/>
                    <button name="action_view_full_stock_history" type="object" string="View Full Stock History"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Product">
                            <field name="product_id"/>
                            <field name="product_default_code"/>
                            <field name="categ_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Location">
                            <field name="warehouse_id"/>
                            <field name="location_id"/>
                            <field name="incident_number"/>
                            <field name="is_corrected"/>
                        </group>
                    </group>
                    <group>
                        <group string="Negative-Creating Movement">
                            <field name="trigger_move_id"/>
                            <field name="trigger_picking_id"/>
                            <field name="picking_type_code"/>
                            <field name="origin_document_name"/>
                            <field name="incident_datetime"/>
                            <field name="corrected_datetime"/>
                        </group>
                        <group string="Quantities">
                            <field name="stock_before"/>
                            <field name="movement_qty"/>
                            <field name="stock_after"/>
                            <field name="negative_qty"/>
                        </group>
                    </group>
                    <group string="Root Cause">
                        <field name="root_cause_type"/>
                        <field name="root_cause_description" colspan="2"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_inventory_negative_stock_incident" model="ir.actions.act_window">
        <field name="name">Negative Stock Incidents</field>
        <field name="res_model">inventory.negative.stock.incident</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_inventory_negative_stock_incident_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No negative-stock incidents yet
            </p>
            <p>
                Open the Negative Stock Analyzer and run a scan to detect
                current and historical negative quantities from stock movement history.
            </p>
        </field>
    </record>
</odoo>
