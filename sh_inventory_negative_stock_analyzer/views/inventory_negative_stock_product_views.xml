<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inventory_negative_stock_product_search" model="ir.ui.view">
        <field name="name">inventory.negative.stock.product.search</field>
        <field name="model">inventory.negative.stock.product</field>
        <field name="arch" type="xml">
            <search string="Negative Stock Products">
                <field name="product_id"/>
                <field name="default_code"/>
                <field name="location_id"/>
                <field name="warehouse_id"/>
                <filter name="filter_active" string="Active" domain="[('status', '=', 'active')]"/>
                <filter name="filter_corrected" string="Corrected" domain="[('status', '=', 'corrected')]"/>
                <filter name="filter_current" string="Current Negative" domain="[('current_qty', '&lt;', 0)]"/>
                <filter name="filter_historical" string="Historical Negative" domain="[('current_qty', '&gt;=', 0)]"/>
                <separator/>
                <filter name="filter_last_negative" string="Last Negative Date" date="last_negative_date"/>
                <group>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_warehouse" string="Warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter name="group_location" string="Location" context="{'group_by': 'location_id'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
                    <filter name="group_categ" string="Product Category" context="{'group_by': 'categ_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_inventory_negative_stock_product_list" model="ir.ui.view">
        <field name="name">inventory.negative.stock.product.list</field>
        <field name="model">inventory.negative.stock.product</field>
        <field name="arch" type="xml">
            <list string="Negative Stock Products" create="false">
                <field name="product_id"/>
                <field name="default_code" optional="show"/>
                <field name="warehouse_id"/>
                <field name="location_id"/>
                <field name="current_qty" decoration-danger="current_qty &lt; 0"/>
                <field name="lowest_qty"/>
                <field name="incident_count"/>
                <field name="last_negative_date"/>
                <field name="status" widget="badge"
                    decoration-danger="status == 'active'"
                    decoration-success="status == 'corrected'"
                    decoration-warning="status == 'investigating'"
                    decoration-muted="status == 'unknown'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_inventory_negative_stock_product_form" model="ir.ui.view">
        <field name="name">inventory.negative.stock.product.form</field>
        <field name="model">inventory.negative.stock.product</field>
        <field name="arch" type="xml">
            <form string="Negative Stock Product" create="false" edit="false">
                <header>
                    <button name="action_open_analyzer" type="object" string="Open Analyzer" class="btn-primary"/>
                    <button name="action_view_incidents" type="object" string="View Incidents"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="default_code"/>
                            <field name="categ_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="warehouse_id"/>
                            <field name="location_id"/>
                            <field name="current_qty"/>
                            <field name="lowest_qty"/>
                            <field name="incident_count"/>
                            <field name="last_negative_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Incidents" name="incidents">
                            <field name="incident_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="incident_number"/>
                                    <field name="stock_before"/>
                                    <field name="stock_after"/>
                                    <field name="trigger_picking_id"/>
                                    <field name="root_cause_type"/>
                                    <field name="incident_datetime"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_inventory_negative_stock_product" model="ir.actions.act_window">
        <field name="name">Negative Stock Products</field>
        <field name="res_model">inventory.negative.stock.product</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_inventory_negative_stock_product_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No products with negative-stock incidents
            </p>
            <p>
                Products appear here after the analyzer detects a running
                inventory balance that crossed below zero.
            </p>
        </field>
    </record>
</odoo>
